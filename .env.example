# ============================================
# MONKEY AI - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# --- Application ---
APP_NAME=Monkey AI
APP_URL=http://localhost:3000
NODE_ENV=development

# --- Authentication ---
JWT_SECRET=change-this-to-a-secure-random-string
SESSION_SECRET=change-this-to-a-secure-random-string

# --- Admin Credentials ---
# IMPORTANT: Change these before production deployment!
ADMIN_USERNAME=57rumaan
ADMIN_PASSWORD=change-this-for-local-development
# In production, use a hashed password:
# ADMIN_PASSWORD_HASH=$2b$10$...

# --- Storage (JSONBin) ---
JSONBIN_API_KEY=your-jsonbin-api-key
JSONBIN_BIN_ID=your-jsonbin-bin-id

# --- AI Provider Keys (Server-side only) ---
# NEVER expose these to the client/browser
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=your-google-ai-key
STABILITY_API_KEY=sk-...
ELEVENLABS_API_KEY=...

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# --- File Upload ---
MAX_FILE_SIZE_MB=10
MAX_FILES_PER_MESSAGE=5

# --- CORS (Production) ---
CORS_ORIGIN=https://your-domain.com
